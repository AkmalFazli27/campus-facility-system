APP_URL=http://localhost:3000
DATABASE_URL=mysql://root:PASSWORD@localhost:3306/campus_facility_dev
# Contoh staging Aiven (simpan di .env.staging.local, jangan commit password asli):
# DATABASE_URL=mysql://campus_app:PASSWORD@HOST:PORT/campus_facility?ssl-mode=REQUIRED
JWT_SECRET=REPLACE-WITH-SECRET-MIN-32-CHARS-1234
JWT_EXPIRES_IN=7d
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=5
# Foto laporan: di Vercel otomatis memakai Vercel Blob (token diisi saat Blob
# store di-connect). Tanpa token (dev lokal) foto ditulis ke public/uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
